{
  "name": "red-sky-renegades-vm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "npm test && npm run build",
    "format": "prettier --write src tests scripts index.html vite.config.ts",
    "test:details": "node scripts/browser-details.mjs",
    "test:territory": "node scripts/browser-territory.mjs",
    "test:campaign": "tsx --test tests/campaign.test.ts",
    "test:campaign-browser": "node scripts/browser-campaign.mjs",
    "fixtures:campaign": "tsx scripts/campaign-fixtures.ts",
    "test:campaign-details": "node scripts/browser-campaign-details.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "0.180.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
